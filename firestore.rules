rules_version = '2';

/*
 * Timberhold data model — two separate ways a camp can live in the cloud:
 *
 *   accounts/{uid}  a signed-in player's camps. Private to that player.
 *   saves/{code}    the code-based manual backup, for playing without an
 *                   account. Whoever holds the code can read and write that
 *                   one document; that is the whole point of it.
 *   leaderboard/…   the rank board. Public to read, yours alone to write.
 *   chat/{id}       the world channel. Public to read, yours alone to write.
 *
 * These rules are deployed from this file (see firebase.json), not edited in
 * the console — otherwise the app and its permissions drift apart silently,
 * which is exactly how account saves ended up unreadable.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function wellFormed(data) {
      return data.keys().hasOnly(['state', 'updatedAt'])
        && data.state is string
        && data.state.size() > 0
        && data.state.size() < 900000;   // ~900 KB of base64 save blob
    }

    // A player's own camps. Nobody else can read or write them.
    match /accounts/{uid} {
      allow get:          if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && wellFormed(request.resource.data);
      allow delete:       if request.auth != null && request.auth.uid == uid;
      allow list:         if false;
    }

    // Code-based backup. Deliberately reachable without signing in, but the
    // code has to look like a code, and the payload shape is pinned down.
    match /saves/{code} {
      allow get:            if code.matches('^[A-Za-z0-9]{6,12}$');
      allow create, update: if code.matches('^[A-Za-z0-9]{6,12}$')
                            && wellFormed(request.resource.data);
      allow delete, list:   if false;
    }

    // The rank board. Readable by anyone so the standings can be shown, but a
    // player may only ever write their own row, and the shape is pinned down so
    // nobody can inflate a score or smuggle extra fields in. Deliberately holds
    // only a chosen camp name, never an email or anything identifying.
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'level', 'total', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.level is int
        && request.resource.data.level >= 1 && request.resource.data.level <= 100000
        && request.resource.data.total is int
        && request.resource.data.total >= 0 && request.resource.data.total <= 1000000;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // World chat. Joshua hands the live link to people he does not know, so
    // this is the surface that has to hold on its own. The word filter and the
    // rate limit in index.html run on the player's device, and a crafted client
    // simply skips them; what cannot be skipped lives here.
    //
    // Readable by anyone, because the channel is shown before you sign in.
    // A message is written once and never edited — allowing update would let an
    // author swap agreed-looking text for something else after the fact.
    // Deletable only by its author, which is also what lets a player clear out
    // their own expired messages without a backend.
    match /chat/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at', 'exp'])
        // you may only ever speak as yourself
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        // a chosen camp name, exactly as the leaderboard does it. Never an email.
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200
        // the server's clock, not the sender's, so a message cannot be backdated
        // to the top of the feed or postdated to sit there forever
        && request.resource.data.at == request.time
        // and it has to expire: a day, with slack for a slow clock
        && request.resource.data.exp is int
        && request.resource.data.exp > request.time.toMillis()
        && request.resource.data.exp <= request.time.toMillis() + 90000000;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
