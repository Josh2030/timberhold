{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      ".git/**",
      ".github/**",
      ".firebase/**",
      "**/node_modules/**",
      "README.md",
      "scripts/**",
      "_site/**",
      "deploy.bat",
      "firestore.rules",
      "node_modules/**",
      "package.json",
      "package-lock.json"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}